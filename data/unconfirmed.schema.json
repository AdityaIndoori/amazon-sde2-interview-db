{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amazon SDE II final-loop questions without verified rounds",
  "type": "object",
  "required": ["slice", "reports"],
  "properties": {
    "slice": {"type": "string", "minLength": 1},
    "reports": {"type": "array", "items": {"$ref": "#/$defs/report"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^202[56](-(?:0[1-9]|1[0-2])(-(?:0[1-9]|[12][0-9]|3[01]))?)?$", "description": "Actual calendar date at the stated precision, inside the strict collection window; compiler checks calendar validity and cutoff."},
    "originalDate": {"type": ["string", "null"], "pattern": "^[0-9]{4}(-(?:0[1-9]|1[0-2])(-(?:0[1-9]|[12][0-9]|3[01]))?)?$"},
    "basis": {"enum": ["interview", "publication"]},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "question": {
      "type": "object",
      "required": ["round", "key", "question", "topic", "evidence", "roundUncertainty"],
      "properties": {
        "round": {"type": "null"},
        "sourceRound": {"type": "string"},
        "roundUncertainty": {"type": "string", "minLength": 1, "description": "Why final-loop status is established but a numbered round cannot be verified."},
        "key": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "question": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/date"},
        "dateBasis": {"$ref": "#/$defs/basis"}
      }
    },
    "report": {
      "type": "object",
      "required": ["id", "url", "title", "role", "stageEvidence", "location", "date", "dateBasis", "questions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"$ref": "#/$defs/url"},
        "retrievedVia": {"$ref": "#/$defs/url"},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/url"}},
        "title": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "stageEvidence": {"type": "string", "minLength": 1},
        "eligibility": {"type": "string"},
        "location": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/date"},
        "dateBasis": {"$ref": "#/$defs/basis"},
        "publishedDate": {"$ref": "#/$defs/originalDate"},
        "interviewDate": {"$ref": "#/$defs/originalDate"},
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
      }
    }
  }
}
