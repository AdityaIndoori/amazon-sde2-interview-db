{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amazon SDE II public-report research slice",
  "type": "object",
  "required": ["slice", "searchedAt", "queries", "reports", "excluded", "limitations"],
  "properties": {
    "slice": {"type": "string", "minLength": 1},
    "searchedAt": {"type": "string", "format": "date"},
    "queries": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "excluded": {"type": "array", "items": {"type": "object", "required": ["url", "reason"], "properties": {"url": {"type": "string", "format": "uri"}, "reason": {"type": "string", "minLength": 1}}}},
    "reports": {"type": "array", "items": {"$ref": "#/$defs/report"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^202[56](-(?:0[1-9]|1[0-2])(-(?:0[1-9]|[12][0-9]|3[01]))?)?$"},
    "basis": {"enum": ["interview", "publication"]},
    "question": {
      "type": "object",
      "required": ["round", "key", "question", "topic", "evidence"],
      "properties": {
        "round": {"type": "integer", "minimum": 1, "maximum": 4},
        "sourceRound": {"type": "string"},
        "roundMappingNote": {"type": "string"},
        "key": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "question": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/date"},
        "dateBasis": {"$ref": "#/$defs/basis"}
      }
    },
    "report": {
      "type": "object",
      "required": ["id", "url", "title", "role", "stageEvidence", "location", "date", "dateBasis", "questions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "retrievedVia": {"type": "string", "format": "uri"},
        "aliases": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "title": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "stageEvidence": {"type": "string", "minLength": 1},
        "eligibility": {"type": "string"},
        "location": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/date"},
        "dateBasis": {"$ref": "#/$defs/basis"},
        "publishedDate": {"type": ["string", "null"]},
        "interviewDate": {"type": ["string", "null"]},
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
      }
    }
  }
}
